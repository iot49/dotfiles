{
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(gh repo delete*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret*)",
      "Bash(gh secret:*)",
      "Bash(gh auth*)",
      "Bash(gh auth:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Read(//**/.aws/credentials)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git clean -fdx*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "nodejs.org",
        "pypi.org",
        "*.pypi.org",
        "files.pythonhosted.org",
        "astral.sh",
        "*.astral.sh",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "*.githubusercontent.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches/uv"
      ]
    },
    "enableWeakerNetworkIsolation": true
  },
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "autoCompactEnabled": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
