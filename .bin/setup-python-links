#!/bin/zsh
# setup-python-links: Create python/pip symlinks dynamically matching current host architecture

LOCAL_BIN="$HOME/.local/bin"
UV_PYTHON_DIR="$HOME/.local/share/uv/python"

mkdir -p "$LOCAL_BIN"

# Detect OS and architecture
OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"

# Normalize architecture names to match uv convention
if [[ "$ARCH" == "arm64" ]]; then
    ARCH_SUFFIX="aarch64"
elif [[ "$ARCH" == "x86_64" ]]; then
    ARCH_SUFFIX="x86_64"
else
    echo "Unsupported architecture: $ARCH" >&2
    exit 1
fi

# Locate standard uv python directory structure
# e.g., ~/.local/share/uv/python/cpython-3.12.13-macos-x86_64-none
# Look for Python 3.12 specifically
UV_PY_PATH=$(find "$UV_PYTHON_DIR" -maxdepth 1 -type d -name "cpython-3.12*-${OS}-${ARCH_SUFFIX}*" | head -n 1)

if [[ -z "$UV_PY_PATH" ]]; then
    # Fallback to any directory if architecture matching failed (e.g. no downloaded toolchains yet)
    UV_PY_PATH=$(find "$UV_PYTHON_DIR" -maxdepth 1 -type d -name "cpython-*" | head -n 1)
fi

if [[ -n "$UV_PY_PATH" ]]; then
    echo "Found uv python toolchain: $UV_PY_PATH"
    
    # Create symlinks
    ln -sf "$UV_PY_PATH/bin/python3" "$LOCAL_BIN/python"
    ln -sf "$UV_PY_PATH/bin/python3" "$LOCAL_BIN/python3"
    ln -sf "$UV_PY_PATH/bin/pip" "$LOCAL_BIN/pip"
    ln -sf "$UV_PY_PATH/bin/pip" "$LOCAL_BIN/pip3"
    
    echo "Successfully updated symlinks in $LOCAL_BIN"
else
    echo "Error: No uv python toolchain found in $UV_PYTHON_DIR" >&2
    echo "Run 'uv python install' first to fetch a python version." >&2
    exit 1
fi
